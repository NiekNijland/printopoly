APP_NAME=Printopoly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=redis

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Production adds bugsnag: LOG_STACK=single,bugsnag
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_BUGSNAG_LEVEL=error

# --- Laravel Sail -----------------------------------------------------------
# Ports on the host. They differ from Sail's defaults so Printopoly can run
# next to motormonitor.
APP_PORT=8090
VITE_PORT=5179
FORWARD_MONGODB_PORT=27018
FORWARD_REDIS_PORT=6382
WWWUSER=1000
WWWGROUP=1000
SAIL_XDEBUG_MODE=off

# --- MongoDB (B48) ----------------------------------------------------------
# Production: DB_DATABASE=printopoly with its own user (runbook-new-site.md).
DB_CONNECTION=mongodb
MONGODB_URI=mongodb://mongodb:27017
DB_DATABASE=printopoly
DB_USERNAME=
DB_PASSWORD=
DB_AUTHENTICATION_DATABASE=printopoly
MONGODB_USERNAME=
MONGODB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=file

CACHE_STORE=redis
# CACHE_PREFIX=

# --- Redis ------------------------------------------------------------------
# The production host shares Redis between sites: 0/1 are motormonitor, 4/5
# vraagwagen, 6/7 Printopoly. Queues live on a second instance (port 6380)
# where only the prefix separates the sites.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=6
REDIS_CACHE_DB=7
REDIS_PREFIX=printopoly-database-

# Locally the queue uses the default connection. Production sets
# REDIS_QUEUE_CONNECTION=queues, REDIS_QUEUE_PORT=6380 and REDIS_QUEUE_PASSWORD.
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_HOST="${REDIS_HOST}"
REDIS_QUEUE_PORT=6380
REDIS_QUEUE_PASSWORD=null
REDIS_QUEUE_DB=0
REDIS_QUEUE_RETRY_AFTER=360

# --- Horizon (B70) ----------------------------------------------------------
HORIZON_PREFIX=printopoly_horizon:
HORIZON_ADMIN_EMAILS=
HORIZON_PDF_MAX_PROCESSES=2
HORIZON_PDF_TIMEOUT=300

# --- Reverb -----------------------------------------------------------------
# 8081 and 8082 belong to motormonitor on the production host.
REVERB_APP_ID=printopoly
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8083
REVERB_HOST=localhost
REVERB_PORT=8083
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Inertia SSR (B66) ------------------------------------------------------
# Only public pages render on the server. The release built by
# build-site-artifact.sh has no SSR bundle yet (B51), so production keeps it off.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714
VITE_INERTIA_SSR_PORT=13714

# --- Google login (B68, B78) ------------------------------------------------
# Optional: without these the app runs and the login button stays hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- PDF rendering (B52, B54) -----------------------------------------------
# Production: LARAVEL_PDF_CHROME_BINARY=/usr/local/bin/chrome-headless-shell
LARAVEL_PDF_DRIVER=chrome
LARAVEL_PDF_CHROME_BINARY=
LARAVEL_PDF_CHROME_NO_SANDBOX=false
LARAVEL_PDF_CHROME_STARTUP_TIMEOUT=30
LARAVEL_PDF_CHROME_TIMEOUT=30000
LARAVEL_PDF_CHROME_OPERATION_TIMEOUT=5000
LARAVEL_PDF_CHROME_USER_DATA_DIR=

# --- Limits (B70, B82) ------------------------------------------------------
PRINTOPOLY_MAX_PHOTO_MB=25
PRINTOPOLY_MAX_PHOTO_MEGAPIXELS=60
PRINTOPOLY_MAX_ACCOUNT_STORAGE_MB=1024
PRINTOPOLY_MAX_EDITIONS_PER_ACCOUNT=20
PRINTOPOLY_MAX_PRINT_JOBS_PER_USER=1
PRINTOPOLY_PRINT_FILE_RETENTION_DAYS=7

# --- Uploads on Cloudflare R2 (B68) -----------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Bugsnag ----------------------------------------------------------------
# Leave the key empty to send nothing. Edition content never goes to Bugsnag.
BUGSNAG_API_KEY=
BUGSNAG_RELEASE_STAGE=
BUGSNAG_NOTIFY_RELEASE_STAGES=production
BUGSNAG_LOGGER_LEVEL=error
VITE_BUGSNAG_API_KEY=
VITE_BUGSNAG_RELEASE_STAGE="${BUGSNAG_RELEASE_STAGE}"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hallo@printopoly.nl"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
