{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "printopoly",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "dev:all": "concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"./artisan serve\" \"./artisan horizon:listen --poll\" \"./artisan pail --timeout=0\" \"npm run dev\" --names=server,horizon,logs,vite --kill-others",
        "dev:all:ssr": "concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"./artisan serve\" \"./artisan horizon:listen --poll\" \"./artisan pail --timeout=0\" \"./artisan inertia:start-ssr\" --names=server,horizon,logs,ssr --kill-others",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "knip": "knip --no-progress",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "ssr:check": "node scripts/check-ssr-self-contained.mjs",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "types": "tsc6 --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@testing-library/jest-dom": "^8.0.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^24.10.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/coverage-v8": "^5.0.3",
        "@vitest/eslint-plugin": "^1.6.27",
        "babel-plugin-react-compiler": "^1.0.0",
        "concurrently": "^10.0.5",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "fake-indexeddb": "^6.2.8",
        "globals": "^17.12.0",
        "happy-dom": "^21.0.4",
        "knip": "^6.47.0",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.71.0",
        "vitest": "^5.0.3"
    },
    "dependencies": {
        "@bugsnag/js": "^9.1.0",
        "@fontsource/great-vibes": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/instrument-sans": "^5.3.0",
        "@fontsource/league-spartan": "^5.3.0",
        "@fontsource/playfair-display": "^5.3.0",
        "@inertiajs/core": "^3.7.1",
        "@inertiajs/react": "^3.7.1",
        "@inertiajs/vite": "^3.7.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@radix-ui/react-dialog": "^1.3.1",
        "@rolldown/plugin-babel": "^0.2.4",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-react": "^6.1.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "heic-to": "^1.6.7",
        "laravel-echo": "^2.6.3",
        "laravel-react-internationalization": "^3.0.0",
        "laravel-vite-plugin": "^3.2.0",
        "lucide-react": "^1.77.0",
        "pusher-js": "^8.6.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "vaul": "^1.1.2",
        "vite": "^8.3.2"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.63.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
        "lightningcss-linux-x64-gnu": "^1.32.0"
    }
}
