{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "resources/js/ssr.tsx",
        "resources/js/pages/**/*.tsx!",
        "scripts/*.mjs",
        "resources/js/lib/{checks,edition,game,photos,print,render}/*.ts!",
        "resources/js/components/render/index.ts!"
    ],
    "project": [
        "resources/js/**/*.{ts,tsx}",
        "!resources/js/types/generated.ts",
        "!resources/js/{actions,routes,wayfinder}/**",
        "scripts/**/*.mjs"
    ],
    "ignoreDependencies": ["concurrently"],
    "ignoreBinaries": ["tsc"]
}
