{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nieknijland/printopoly",
    "type": "project",
    "description": "Design your own edition of the classic trading board game and download it as a print set.",
    "keywords": [
        "printopoly",
        "board-game",
        "print"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-mongodb": "^2.4",
        "bugsnag/bugsnag-laravel": "^2.31",
        "chrome-php/chrome": "^1.15",
        "inertiajs/inertia-laravel": "^3.7",
        "intervention/image": "^4.4",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.52",
        "laravel/reverb": "^1.14",
        "laravel/socialite": "^5.33",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.23",
        "league/flysystem-aws-s3-v3": "^3.0",
        "mongodb/laravel-mongodb": "^5.12",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-pdf": "^2.14",
        "spatie/laravel-typescript-transformer": "^2.6"
    },
    "require-dev": {
        "brianium/paratest": "^7.29",
        "fakerphp/faker": "^1.24",
        "infection/infection": "^0.35.12",
        "larastan/larastan": "^3.15",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.71",
        "mockery/mockery": "^1.6",
        "nikic/php-parser": "^5.9",
        "nunomaduro/collision": "^8.8",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.8",
        "rector/rector-laravel": "^2.7",
        "roave/security-advisories": "dev-latest",
        "shipmonk/dead-code-detector": "^1.4",
        "spaze/phpstan-disallowed-calls": "^4.15",
        "symfony/yaml": "^8.1",
        "tomasvotruba/type-coverage": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan horizon:listen --poll\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,horizon,logs,vite --kill-others"
        ],
        "dev:ssr": [
            "Composer\\Config::disableProcessTimeout",
            "npm run build:ssr",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan horizon:listen --poll\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,horizon,logs,ssr --kill-others"
        ],
        "refactor": "rector",
        "pint": "@php vendor/bin/pint --parallel --config https://raw.githubusercontent.com/DIJ-digital/pint-config/2478b98bf2be0ee3cc8595998d6007d09b936793/pint.json",
        "lint:syntax": "@php vendor/bin/parallel-lint --exclude vendor --exclude node_modules --exclude storage --exclude bootstrap/cache --exclude .claude .",
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=2G",
            "@php vendor/bin/phpstan analyse -c phpstan-tests.neon --memory-limit=2G"
        ],
        "generate": [
            "@php artisan typescript:transform",
            "@php artisan wayfinder:generate --with-form --no-interaction"
        ],
        "security": "@composer audit --locked",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "test": "bash scripts/checks.sh",
        "test:lint": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/rector process --dry-run",
            "@pint --test",
            "@lint:syntax",
            "npm run format:check"
        ],
        "test:types": [
            "Composer\\Config::disableProcessTimeout",
            "@analyse"
        ],
        "test:type-coverage": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "test:unit": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php -d pcov.enabled=1 vendor/bin/phpunit --coverage-clover coverage/clover.xml --fail-on-warning --fail-on-deprecation",
            "bash scripts/checks.sh --coverage coverage/clover.xml"
        ],
        "lint": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/rector process",
            "@pint",
            "npm run format"
        ],
        "update:requirements": [
            "Composer\\Config::disableProcessTimeout",
            "composer update --no-interaction",
            "composer bump"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "platform": {
            "ext-mongodb": "2.4.1"
        },
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
